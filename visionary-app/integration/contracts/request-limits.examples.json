    { "kind": "read", "outcome": "transient", "reauthorized": false, "expectedOk": false },
    { "kind": "write", "outcome": "unknown", "sameCommand": true, "samePayload": true, "reauthorized": true, "expectedOk": false },
    { "kind": "write", "outcome": "confirmed-not-committed", "sameCommand": true, "samePayload": true, "reauthorized": true, "expectedOk": true },
    { "kind": "write", "outcome": "confirmed-not-committed", "sameCommand": true, "samePayload": false, "reauthorized": true, "expectedOk": false },
    { "kind": "write", "outcome": "confirmed-not-committed", "sameCommand": false, "samePayload": true, "reauthorized": true, "expectedOk": false }
  ]
