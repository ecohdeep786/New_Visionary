+		},
+		{
+			name:      "third result relevant",
+			retrieved: []string{"x", "y", "a"},
+			relevant:  []string{"a"},
+			want:      1.0 / 3.0,
+		},
+		{
+			name:      "no relevant results",
+			retrieved: []string{"x", "y", "z"},
+			relevant:  []string{"a", "b"},
+			want:      0.0,
+		},
+		{
+			name:      "empty retrieved",
+			retrieved: []string{},
+			relevant:  []string{"a"},
+			want:      0.0,
