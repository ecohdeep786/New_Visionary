# Firebase is the only identity source (FAP-93): no local auth mode exists.
# Production reads the committed public Web app configuration from
# infrastructure/gcp/firebase-web-config.json (build-image.mjs injects the six
# public values). Local development needs one of:
#   1. Real project config below in an ignored .env.local; never a private key.
#   2. The Auth Emulator: a demo- prefixed VITE_FIREBASE_PROJECT_ID plus
#      VITE_FIREBASE_AUTH_EMULATOR_URL (for example http://127.0.0.1:9099).
# Without either, sign-in fails closed ("Sign-in is temporarily unavailable").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=visionary-research.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=visionary-research
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=visionary-research.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Authentication does not require Analytics or measurementId.
# Never put service-account credentials or private keys in VITE_* variables.
# VITE_AUTH_MODE=firebase stays the explicit connected-runtime marker; the
# production image pins it and the browser review fixture asserts it.
VITE_AUTH_MODE=firebase
