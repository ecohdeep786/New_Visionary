+/* The gallery controller ΓÇö Apple's chapter galleries are horizontal tracks:
+   the reader swipes, the paddles step, and the chapter answers. Position is
+   read as a fraction of the track's travel, so every slide is reachable even
+   when the last cards cannot touch the spine; the lock keeps an in-flight
+   smooth scroll from re-deriving intermediate states. */
+function useGalleryTrack(total) {
+  const reduced = usePrefersReducedMotion();
+  const trackRef = useRef(null);
+  const lockRef = useRef(0);
+  const rafRef = useRef(0);
+  const [active, setActive] = useState(0);
+  const [canPrev, setCanPrev] = useState(false);
+  const [canNext, setCanNext] = useState(true);
+
+  const update = useCallback(() => {
+    const track = trackRef.current;
+    if (!track) return;
+    setCanPrev(track.scrollLeft > 4);
+    setCanNext(track.scrollLeft < track.scrollWidth - track.clientWidth - 4);
+  }, []);
+
+  const onScroll = useCallback(() => {
+    if (rafRef.current) return;
+    rafRef.current = requestAnimationFrame(() => {
+      rafRef.current = 0;
+      const track = trackRef.current;
+      if (!track) return;
+      update();
+      if (Date.now() < lockRef.current) return;
+      const max = track.scrollWidth - track.clientWidth;
+      if (max <= 4 || total < 2) return;
+      setActive(Math.min(total - 1, Math.max(0, Math.round((track.scrollLeft / max) * (total - 1)))));
+    });
+  }, [total, update]);
+
+  const stepTo = useCallback((i) => {
+    const clamped = Math.min(total - 1, Math.max(0, i));
+    setActive(clamped);
+    lockRef.current = Date.now() + 700;
+    const track = trackRef.current;
+    if (!track) return;
+    const max = Math.max(0, track.scrollWidth - track.clientWidth);
+    track.scrollTo({
+      left: (clamped / Math.max(1, total - 1)) * max,
+      behavior: reduced ? "auto" : "smooth",
+    });
+  }, [reduced, total]);
+
+  useEffect(() => {
+    update();
+    window.addEventListener("resize", update, { passive: true });
+    return () => window.removeEventListener("resize", update);
+  }, [update]);
+  useEffect(() => () => cancelAnimationFrame(rafRef.current), []);
+  return { trackRef, active, canPrev, canNext, stepTo, onScroll };
+}
