{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "src/admission/**/*.ts",
    "src/concurrency/**/*.ts",
    "src/data/**/*.ts",
    "src/consent/**/*.ts",
    "src/file/download*.ts",
    "src/commands/**/*.ts",
    "src/overview/**/*.ts",
    "src/outbox/outbox-types.ts",
    "src/outbox/outbox-store.ts",
    "src/outbox/outbox.dispatcher.ts"
  ]
}
