# Add only to ignored backend configuration after reviewed SQL schema/role setup.
# Keep existing Firebase configuration. This feature is explicitly disabled by default.
DATA_WORKSPACE_PROVISIONING_ENABLED=false
DATA_WORKSPACE_DATABASE_MODE=local
DATA_WORKSPACE_ENVIRONMENT_ID=local-developer
DATA_WORKSPACE_SCHEMA=product
DATA_WORKSPACE_RUNTIME_ROLE=workspace_runtime
# Runtime DML role only; never use the migration/admin URL in the product.
DATA_WORKSPACE_RUNTIME_URL=postgresql://workspace_runtime:REPLACE_LOCALLY@127.0.0.1:55436/visionary_data_test_workspace?schema=product&connection_limit=3&pool_timeout=5&connect_timeout=5
# Production additionally requires reviewed cloud-sql mode, exact instance/database,
# a private mounted Cloud SQL socket, versioned runtime secret and GCP acceptance.
# Local/staging Firestore links are target-bound development records, even with live auth.
