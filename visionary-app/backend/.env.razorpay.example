# Append to upstream/backend/.env. Keep actual values ignored and server-only.
# This implementation accepts test keys only. It cannot be enabled live by key replacement.
BILLING_MODE=test
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=
# Random server secret; configure the SAME value on the Razorpay test webhook.
RAZORPAY_WEBHOOK_SECRET=
# Independent 64-character lowercase hex secret for the future Cloud Scheduler job.
# Missing token disables the job endpoint. Keep its configured header out of logs/source.
BILLING_RECONCILE_TOKEN=
# Provision idempotently with node scripts/razorpay-configure-test.cjs after backend build.
RAZORPAY_PLAN_PERSONAL_MONTHLY=
RAZORPAY_PLAN_PERSONAL_ANNUAL=
RAZORPAY_PLAN_FAMILY_MONTHLY=
RAZORPAY_PLAN_FAMILY_ANNUAL=
