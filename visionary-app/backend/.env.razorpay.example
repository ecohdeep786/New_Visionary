# Append to upstream/backend/.env. Keep actual values ignored and server-only.
# BILL-07 / KAN-108 separates test and live environments explicitly. Absent or
# unrecognized BILLING_MODE resolves to test, which is the previous behavior.
# Live requires BOTH BILLING_MODE=live AND BILLING_LIVE_ENABLED=true; a lone
# BILLING_MODE=live performs no charge and answers 503. Records, plan ids and
# invoice prefixes are mode-scoped, so a test transaction can never appear in
# live history (the same UID is retained in both).
BILLING_MODE=test
# Live charges also require this explicit second opt-in. Leave unset for test.
BILLING_LIVE_ENABLED=
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=
# Random server secret; configure the SAME value on the Razorpay test webhook.
RAZORPAY_WEBHOOK_SECRET=
# Independent 64-character lowercase hex secret for the future Cloud Scheduler job.
# Missing token disables the job endpoint. Keep its configured header out of logs/source.
BILLING_RECONCILE_TOKEN=
# Provision idempotently with node scripts/razorpay-configure-test.cjs after backend build.
RAZORPAY_PLAN_PERSONAL_MONTHLY=
RAZORPAY_PLAN_PERSONAL_ANNUAL=
RAZORPAY_PLAN_FAMILY_MONTHLY=
RAZORPAY_PLAN_FAMILY_ANNUAL=
# Live charge plans are configured separately and are read only when BILLING_MODE=live
# (RazorpayProvider.planId appends _LIVE, so a live charge never names a test plan).
# A missing live plan is a typed 503; startup never provisions, guesses or looks up a
# plan. Provision these against the live merchant before enabling live billing, and use
# rzp_live_* keys in live mode.
# RAZORPAY_PLAN_PERSONAL_MONTHLY_LIVE=
# RAZORPAY_PLAN_PERSONAL_ANNUAL_LIVE=
# RAZORPAY_PLAN_FAMILY_MONTHLY_LIVE=
# RAZORPAY_PLAN_FAMILY_ANNUAL_LIVE=
