# Append these to the backend's ignored configuration when integration is ready.
FIREBASE_PROJECT_ID=visionary-research
FIREBASE_PROJECT_KIND=production
# GCP production uses the attached runtime service account and ADC; no key is
# committed or supplied by the release. For a local key, point to an ignored
# file outside frontend/public; never paste its JSON into source or this template.
GOOGLE_APPLICATION_CREDENTIALS=
# Production must never contain FIREBASE_AUTH_EMULATOR_HOST.
# The standalone auth server needs Firestore, not the imported application's DB/Redis.
# The Mumbai database is named default (without parentheses).
FIRESTORE_DATABASE_ID=default
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# Persistent random secret, at least 32 characters; keep the real value ignored.
AUTH_RATE_LIMIT_KEY=
