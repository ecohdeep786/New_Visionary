# Append these to the backend's ignored configuration when integration is ready.
FIREBASE_PROJECT_ID=visionary-fd6d2
FIREBASE_PROJECT_KIND=production
# Prefer deployed workload identity/ADC. For a local key, point to an ignored
# file outside frontend/public; never paste its JSON into source or this template.
GOOGLE_APPLICATION_CREDENTIALS=
# Production must never contain FIREBASE_AUTH_EMULATOR_HOST.
# Auth SDK installation does not replace required application DB/Redis settings.
